{
  "name": "vite-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  },
  "lint-staged": {
    "*.{html,vue,ts,cjs,json,md}": [
      "prettier --write"
    ],
    "*.{vue,js,ts,jsx,tsx}": [
      "eslint --cache --fix"
    ],
    "*.{vue,css,scss,html}": [
      "stylelint --fix --allow-empty-input"
    ]
  }
}
